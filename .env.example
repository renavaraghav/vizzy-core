# Cloudflare Workers AI configuration
# Set these in .env.local (never commit .env.local):
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# Optional: defaults to @cf/black-forest-labs/flux-1-schnell
# Other options: @cf/stabilityai/stable-diffusion-xl-base-1.0
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# (Optional fallback) Hugging Face token
# HF_TOKEN=your_hugging_face_token
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
